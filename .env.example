# Public site URL, used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# Contact form delivery (Resend). Without these the form tells visitors to email instead.
RESEND_API_KEY=
ENQUIRY_TO=
ENQUIRY_FROM=

# Content editor at /admin. ADMIN_PASSWORD: at least 8 characters.
# GITHUB_TOKEN: fine-grained token for the repo with Contents read and write (production only;
# without it, local dev edits the files on disk).
ADMIN_PASSWORD=
GITHUB_TOKEN=
GITHUB_REPO=ildaahaxhiu-cell/atomikstudio-website
GITHUB_BRANCH=main
